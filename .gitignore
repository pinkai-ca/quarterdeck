# Ships are their own repositories. The five templates travel with the framework:
# drydock, default, forum, cascade and shuttle.
ships/*
!ships/drydock/
!ships/default/
!ships/forum/
!ships/cascade/
!ships/shuttle/
# A ship's state is fenced in a nested repository and never tracked anywhere.
ships/*/runtime/
# Worktrees for work on the framework itself live here, inside the project folder.
work/
!ships/forum/work/
# Test runs, their results and reports, and the native test sockets (tests/testrun.py, tests/conftest.py).
.testruns/

.venv/
__pycache__/
*.egg-info/
.pytest_cache/
build/
dist/
